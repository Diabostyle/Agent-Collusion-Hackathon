# Google Gemini / Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Default model: gemini-3.8-flash, gemini-2.5-flash, gemini-2.5-pro, gpt-4o-mini, claude-3-5-sonnet
COLLUSION_MODEL=gemini-3.8-flash

# Optional per-agent model overrides (inherits COLLUSION_MODEL if omitted)
# CUSTODIAN_MODEL=gemini-2.5-flash
# ANONYMIZER_MODEL=gemini-2.5-pro
# ANALYST_MODEL=gemini-2.5-flash

# DeepSeek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

